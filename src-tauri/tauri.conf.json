{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supply Check",
  "version": "0.1.5",
  "identifier": "com.supplycheck.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supply Check",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic", "mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Audit OpenAI, Claude, and Google model channels",
    "longDescription": "Fill in an API base URL and key, then run the full 22-probe suite against every model using the vendor's official SDK. Produces a per-probe evidence view and a PDF report.",
    "externalBin": ["binaries/supply-check-sdk"],
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      }
    }
  }
}
